# Keep data, secrets and local cruft OUT of the build context / image.
.git
.gitignore
.github/
.claude/
.env
.env.*
!.env.example
data/
*.db
*.sqlite*
*.db-wal
*.db-shm
invoice_logo.*
backups/
*.bak
*.csv
__pycache__/
*.py[cod]
.venv/
venv/
*.md
docker-compose*.yml
Dockerfile
# Dev-only tooling — never needed at runtime.
tests/
pyproject.toml
requirements-dev.txt
.pytest_cache/
.ruff_cache/
